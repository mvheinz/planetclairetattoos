# Produktions-Konfiguration für den Docker-Exit-Pfad (docs/ARCHITEKTUR.md §13). Kopieren nach `.env.production`
# (nie committen) und im Passwort-Manager vorhandene Geheimnisse eintragen.
# ERZEUGT aus src/lib/env.schema.ts mit `pnpm env:example` – nicht von Hand ändern.
# Zusätzlich für die Compose-Datei: POSTGRES_PASSWORD (gleiches Passwort wie in DATABASE_URL).

POSTGRES_PASSWORD=

# --- Kern und Laufzeit ---
# Umgebungskennung: development | test | preview | staging | production (ARCHITEKTUR §4.2) · seit P1
APP_ENV=production
# Postgres-Verbindung der App (Neon: gepoolte URL mit -pooler) (geheim) · seit P0
DATABASE_URL=postgres://planetclaire:HIER_DB_PASSWORT@postgres:5432/planetclaire
# Größe des pg-Pools (Int-Tests 25, Vercel 5) · seit P1
DB_POOL_MAX=10
# Payload-Signaturen und Wurzel für abgeleitete Schlüssel (HKDF, ARCHITEKTUR §8.6); mindestens 32 zufällige Zeichen (geheim) · seit P0
PAYLOAD_SECRET=
# Kanonische Basis-URL ohne / am Ende · seit P0
NEXT_PUBLIC_SITE_URL=https://planetclairetattoos.com
# Pfad der Verwaltung (nicht /admin, E-93) · seit P1
ADMIN_ROUTE=/werkstatt
# Bearer für /api/cron/*, /api/health?deep=1, /api/payload-jobs/run (mindestens 32 Zeichen) (geheim) · seit P1
CRON_SECRET=
# Payload jobs.autoRun im Prozess (true lokal/Docker, false Vercel/Tests) · seit P1
JOBS_AUTORUN=true
# Log-Stufe: debug | info | warn | error · seit P1
LOG_LEVEL=info
# Wartungsmodus (ARCHITEKTUR §10.5) · seit P10
MAINTENANCE_MODE=false
# Prozess-Zeitzone, immer UTC (Code rechnet mit Europe/Berlin) · seit P1
TZ=UTC

# --- Beispielbestand, Vorschau, QA ---
# Seed-Medien ohne Einwilligung und Banner zeigen (nie in Produktion, R-181) · seit P0
SEED_PREVIEW_MODE=false

# --- Speicher ---
# Speicher-Treiber: local | s3 · seit P0
STORAGE_DRIVER=s3
# Wurzelordner für local · seit P1
STORAGE_LOCAL_DIR=.data
# S3-Endpunkt (R2: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com) · seit P0
S3_ENDPOINT=
# Region · seit P0
S3_REGION=auto
# Bucket für media und documents · seit P0
S3_BUCKET=
# Bucket für private-uploads und Systemdateien · seit P1
S3_PRIVATE_BUCKET=
# Zugangsschlüssel (R2-Token nur für diese zwei Buckets) (geheim) · seit P0
S3_ACCESS_KEY_ID=
# Geheimnis dazu (geheim) · seit P0
S3_SECRET_ACCESS_KEY=
# Pfad-Adressierung (R2/MinIO) · seit P1
S3_FORCE_PATH_STYLE=true

# --- E-Mail ---
# Mail-Treiber: file | smtp | memory | log · seit P0
EMAIL_DRIVER=smtp
# SMTP-Server (Mailpit lokal, Lettermint in Produktion) · seit P0
SMTP_HOST=127.0.0.1
# Port (1025 Mailpit, 587 STARTTLS oder 465) · seit P0
SMTP_PORT=1025
# true nur bei Port 465 · seit P1
SMTP_SECURE=false
# SMTP-Benutzer (geheim) · seit P0
SMTP_USER=
# SMTP-Passwort/Token (geheim) · seit P0
SMTP_PASS=
# Absender · seit P0
MAIL_FROM="Planet Claire <shop@planetclairetattoos.com>"
# Antwortadresse · seit P0
MAIL_REPLY_TO=jutta@planetclairetattoos.com
# Startwert/Rückfall für settings.adminNotificationEmail · seit P0
ADMIN_NOTIFY_EMAIL=jutta@planetclairetattoos.com

# --- Zahlung ---
# Zahlungs-Treiber: mock | stripe · seit P0
PAYMENTS_DRIVER=stripe
# Stripe-Server-Schlüssel (sk_test_/rk_test_; Live nur in Produktion) (geheim) · seit P0
STRIPE_SECRET_KEY=
# Signatur-Geheimnis des Webhook-Endpunkts (whsec_…) (geheim) · seit P0
STRIPE_WEBHOOK_SECRET=
# Stripe-Browser-Schlüssel (nur Kasse) · seit P0
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Übersetzung, Versand, Statistik, Monitoring ---
# Übersetzungs-Treiber: mock | deepl · seit P0
TRANSLATION_DRIVER=deepl
# DeepL API Free (…:fx) (geheim) · seit P0
DEEPL_API_KEY=
# Versanddienst-Adapter: manual · seit P1
CARRIER_DRIVER=manual
# Vercel Web Analytics rendern (wirksam ab P10) · seit P1
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Browser-Fehlermeldungen an POST /api/client-errors (nur Produktion, nach K-30 c) · seit P10
NEXT_PUBLIC_CLIENT_ERRORS_ENABLED=false
# Sentry EU, leer = aus (geheim) · seit P0
SENTRY_DSN=
# Umgebungsname in Sentry (leer = APP_ENV) · seit P10
SENTRY_ENVIRONMENT=

# --- Backup (nur Produktion, §10) ---
# Nächtliches Backup aktiv · seit P10
BACKUP_ENABLED=false
# Backup-Bucket (EU) · seit P10
BACKUP_S3_BUCKET=
# Eigener R2-Token nur für den Backup-Bucket (geheim) · seit P10
BACKUP_S3_ACCESS_KEY_ID=
# Geheimnis dazu (geheim) · seit P10
BACKUP_S3_SECRET_ACCESS_KEY=
# Öffentlicher age-Schlüssel (age1…) für die Verschlüsselung · seit P10
BACKUP_AGE_RECIPIENT=

# --- Build und Test ---
# Next-Telemetrie aus · seit P0
NEXT_TELEMETRY_DISABLED=1
