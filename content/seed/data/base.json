      "slug": {
        "de": "keramik",
        "en": "ceramics"
      },
      "sortOrder": 10,
      "showInNavigation": true,
      "intro": {
        "de": "Alles hier ist von Hand geformt und bemalt – mit Tieren, die zurückschauen. Jede Keramik ist ein Deko-Stück: für Schlüssel, Ringe und Kleinkram, nicht für Essen.",
        "en": "Everything here is shaped and painted by hand – with animals that look back at you. Every ceramic piece is decorative: for keys, rings and small things, not for food."
      }
    },
    {
      "key": "textil",
      "name": {
        "de": "Textil",
        "en": "Textiles"
      },
      "slug": {
        "de": "textil",
        "en": "textiles"
      },
      "sortOrder": 20,
      "showInNavigation": true,
      "intro": {
        "de": "Stoffe mit einer Vorgeschichte, die ich weitermale. Größe, Zustand und Material stehen bei jedem Stück – bitte miss kurz nach, jedes gibt es nur einmal.",
        "en": "Cloth with a past, which I paint onward. Size, condition and fabric are given for every piece – please measure, each exists only once."
      }
    },
    {
      "key": "cap",
      "name": {
        "de": "Caps",
        "en": "Caps"
      },
      "slug": {
        "de": "caps",
        "en": "caps"
      },
      "sortOrder": 30,
      "showInNavigation": true,
      "intro": {
        "de": "Gebrauchte Caps mit neuen Bewohnern. Ob verstellbar oder feste Größe, steht bei jeder Cap dabei.",
        "en": "Pre-loved caps with new residents. Whether adjustable or a fixed size is stated on each cap."
      }
    },
    {
      "key": "zeichnung",
      "name": {
        "de": "Zeichnungen",
        "en": "Drawings"
      },
      "slug": {
        "de": "zeichnungen",
        "en": "drawings"
      },
      "sortOrder": 40,
      "showInNavigation": true,
      "intro": {
        "de": "Originale auf Papier: Tusche, Aquarell, Seiten aus dem Skizzenbuch. Keine Drucke – was du siehst, ist genau das Blatt, das zu dir kommt.",
        "en": "Originals on paper: ink, watercolour, pages from the sketchbook. No prints – what you see is exactly the sheet that will come to you."
      }
    },
    {
      "key": "schmuck",
      "name": {
        "de": "Schmuck",
        "en": "Jewellery"
      },
      "slug": {
        "de": "schmuck",
        "en": "jewellery"
      },
      "sortOrder": 50,
      "showInNavigation": true,
      "intro": {
        "de": "Winzige Anhänger aus Keramik mit Öse aus Edelstahl. Die Kette ist nicht dabei – deine Lieblingskette wartet bestimmt schon.",
        "en": "Tiny ceramic pendants with a stainless steel loop. The chain is not included – your favourite one is surely waiting already."
