{
  "name": "planetclairetattoos",
  "version": "0.1.0",
  "private": true,
  "description": "Website, Shop und Tattoo-Bereich für planetclairetattoos.com (Next.js + Payload CMS)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6144\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload generate:types",
    "payload": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . && pnpm run format:check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts",
    "test:int": "pnpm run db:ensure && pnpm run db:reset --test && cross-env PC_DB_READY=1 NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "pnpm run db:ensure && pnpm run db:reset --test --seed=all && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm --import=./scripts/lib/register-server-only.mjs\" playwright test --config=playwright.config.ts",
    "test:perf": "lhci collect --config=tests/perf/lighthouserc.cjs && lhci upload --config=tests/perf/lighthouserc.cjs && tsx scripts/perf/lighthouse-report.ts && lhci assert --config=tests/perf/lighthouserc.cjs",
    "test:visual": "pnpm run db:ensure && pnpm run db:reset --test --seed=all && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm --import=./scripts/lib/register-server-only.mjs\" playwright test --config=playwright.visual.config.ts",
    "preview:export": "cross-env NODE_OPTIONS=--no-deprecation tsx --import=./scripts/lib/register-server-only.mjs scripts/preview-export/index.ts",
    "test:preview-export": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm --import=./scripts/lib/register-server-only.mjs\" playwright test --config=playwright.preview.config.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run check:static && pnpm run test:unit",
    "check:versions": "tsx scripts/check-versions.ts",
    "env:example": "tsx --import=./scripts/lib/register-server-only.mjs scripts/gen-env-example.ts",
    "check:static": "tsx --import=./scripts/lib/register-server-only.mjs scripts/check-static.ts",
    "db:ensure": "tsx --import=./scripts/lib/register-server-only.mjs scripts/db-ensure.ts",
    "db:reset": "tsx --import=./scripts/lib/register-server-only.mjs scripts/db-reset.ts",
    "check:migrations": "tsx --import=./scripts/lib/register-server-only.mjs scripts/check-migration-drift.ts",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload run scripts/seed/cli.ts -- all",
    "seed:base": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload run scripts/seed/cli.ts -- base",
    "seed:example": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload run scripts/seed/cli.ts -- example",
    "seed:remove": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload run scripts/seed/cli.ts -- remove",
    "seed:reset": "cross-env NODE_OPTIONS=\"--no-deprecation --import=./scripts/lib/register-server-only.mjs\" payload run scripts/seed/cli.ts -- reset",
    "jobs:run": "tsx --import=./scripts/lib/register-server-only.mjs scripts/jobs-run.ts",
    "payments:reconcile": "tsx --import=./scripts/lib/register-server-only.mjs scripts/payments-reconcile.ts",
    "stripe:fixture": "tsx --import=./scripts/lib/register-server-only.mjs scripts/stripe-fixture.ts",
    "admin:create": "tsx --import=./scripts/lib/register-server-only.mjs scripts/admin-create.ts",
    "admin:unlock": "tsx --import=./scripts/lib/register-server-only.mjs scripts/admin-unlock.ts",
    "check:external": "tsx scripts/check-external.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:no-debug": "tsx scripts/check-no-debug.ts",
    "ci:artifacts": "tsx scripts/ci/artifact-budget.ts",
    "ci:minutes": "tsx scripts/ci/minutes.ts",
    "fonts:copy": "tsx scripts/fonts/copy.ts",
    "art:brand": "tsx scripts/art/build-brand.ts",
    "art:icons": "tsx scripts/art/build-icons.ts",
    "art:coco-placeholder": "tsx scripts/art/draw-coco-placeholder.ts",
    "art:sprite": "tsx scripts/art/build-sprite.ts",
    "art:calibration": "tsx scripts/art/calibration-sheet.ts",
    "fixtures:barcodes": "tsx scripts/fixtures/barcodes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@date-fns/tz": "1.2.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-pdf/renderer": "4.9.0",
    "@stripe/stripe-js": "9.17.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "cross-env": "7.0.3",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "fflate": "0.8.2",
    "graphql": "16.14.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "nodemailer": "9.1.1",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/mansalva": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.19.9",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "4.5.2",
    "bwip-js": "4.11.4",
    "cheerio": "1.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "exifr": "7.1.3",
    "fontkit": "2.0.4",
    "jsdom": "28.0.0",
    "jsqr": "1.4.0",
    "pdf-parse": "2.4.5",
    "prettier": "3.9.9",
    "smtp-server": "3.19.13",
    "subset-font": "2.9.0",
    "svgo": "4.1.0",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wawoff2": "2.0.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
