# Beispiel-Konfiguration. Kopieren nach `.env` (wird nie committet).
# Vollständige Beschreibung aller Variablen: docs/ARCHITEKTUR.md (Abschnitt Umgebungsvariablen).
# Bis zum Go-live (P11) laufen alle Integrationen über lokale Treiber/Mocks – keine echten Schlüssel nötig.

# --- Kern ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/planetclaire
# Mindestens 32 zufällige Zeichen, z. B. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=change-me-dev-only-0000000000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Beispielbestand / Vorschau ---
# true = Seed-Inhalte (inkl. Tattoo-Fotos ohne Einwilligung) dürfen angezeigt werden. NIE in Produktion.
SEED_PREVIEW_MODE=true

# --- Speicher (local | s3) ---
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- E-Mail (file | smtp) ---
EMAIL_DRIVER=file
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Planet Claire <shop@planetclairetattoos.com>"
MAIL_REPLY_TO=jutta@planetclairetattoos.com
ADMIN_NOTIFY_EMAIL=jutta@planetclairetattoos.com

# --- Zahlung (mock | stripe) ---
PAYMENTS_DRIVER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Übersetzen-Knopf (mock | deepl) ---
TRANSLATION_DRIVER=mock
DEEPL_API_KEY=

# --- Betrieb ---
CRON_SECRET=change-me-dev-only
# Eigener Pfad für die Verwaltung (nicht /admin), siehe E-93
ADMIN_ROUTE=/admin
SENTRY_DSN=
